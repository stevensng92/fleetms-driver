# Copy to .env. Both vars below are required for real-data screens.
# EXPO_PUBLIC_ vars get inlined into the JS bundle — never put service-role
# keys or secrets here. Anon key is safe (RLS gates access).

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Dev shortcut: silently signs the app in as this driver on boot. The user
# must exist in auth.users AND be linked to a drivers row (drivers.user_id =
# auth.users.id) in the FleetMS dispatcher project. Delete both lines once
# /sign-in is wired for real OTP.
EXPO_PUBLIC_DEV_DRIVER_EMAIL=driver-test@example.com
EXPO_PUBLIC_DEV_DRIVER_PASSWORD=
